{
  "id": "demoB",
  "title": "What If You Woke Up in 1955 With Everything You Know Today?",
  "voice": "am_eric",
  "speed": 0.95,
  "theme": "retro",
  "scenes": [
    {"text": "You open your eyes, and the alarm clock on the nightstand is ringing.", "bg": "bedroom55",
     "chars": [{"id": "hero", "pose": "stretch", "pose2": "idle", "x": 880, "color": "#5c6b73", "mood": "sleepy", "mood2": "normal", "hair": "gray"}],
     "cam": {"z": [1.3, 1.05], "x": [60, 0], "y": [40, 0]},
     "overlay": {"type": "title", "text": "WHAT IF YOU WOKE UP IN 1955?"}, "sfx": "ring"},
    {"text": "The calendar on the wall says June, nineteen fifty-five.", "bg": "bedroom55",
     "chars": [{"id": "hero", "pose": "surprised", "x": 620, "color": "#5c6b73", "mood": "wide", "hair": "gray"}],
     "cam": {"z": [1.0, 1.2], "x": [0, -160], "y": [0, 0]},
     "overlay": {"type": "calendar", "text": "JUNE", "sub": "1955", "at": 0.35}, "sfx": "pop"},
    {"text": "And you still remember everything you know today. Every invention, every price, every headline.", "bg": "abstract55",
     "chars": [{"id": "hero", "pose": "think", "x": 760, "color": "#5c6b73", "hair": "gray"}],
     "cam": {"z": [1.1, 1.0], "x": [0, 0], "y": [0, 0]},
     "overlay": {"type": "bubble", "items": ["THE MOON LANDING", "THE INTERNET", "YOUR PHONE"], "at": 0.3}, "sfx": "shimmer"},
    {"text": "You walk into the corner diner, and a cup of coffee costs about a dime.", "bg": "diner",
     "chars": [{"id": "hero", "pose": "walk", "pose2": "idle", "x": 700, "color": "#5c6b73", "hair": "gray", "enter": "left"},
               {"id": "cook", "pose": "idle", "pose2": "wave", "x": 1380, "color": "#f1faee", "facing": -1, "hat": "paper"}],
     "cam": {"z": [1.0, 1.1], "x": [0, -40], "y": [0, 0]},
     "overlay": {"type": "sticker", "text": "10¢", "at": 0.7}, "sfx": "ding"},
    {"text": "At the gas station, a gallon of gas is around twenty-five cents.", "bg": "gas",
     "chars": [{"id": "att", "pose": "wave", "x": 1250, "color": "#e63946", "facing": -1, "hat": "cap"},
               {"id": "hero", "pose": "surprised", "x": 640, "color": "#5c6b73", "mood": "wide", "hair": "gray"}],
     "cam": {"z": [1.05, 1.15], "x": [0, 60], "y": [0, 0]},
     "overlay": {"type": "sticker", "text": "25¢", "at": 0.6}, "sfx": "pop"},
    {"text": "You know which small companies will grow into giants, and how the next seventy years will turn out.", "bg": "abstract55",
     "chars": [{"id": "hero", "pose": "point", "x": 560, "color": "#5c6b73", "hair": "gray"}],
     "cam": {"z": [1.0, 1.08], "x": [0, 0], "y": [0, 0]},
     "overlay": {"type": "growth", "at": 0.2}, "sfx": "whoosh"},
    {"text": "But here is the catch.", "bg": "street55", "transition": "sticky",
     "chars": [{"id": "hero", "pose": "idle", "x": 960, "color": "#5c6b73", "hair": "gray"}],
     "cam": {"z": [1.0, 1.4], "x": [0, 0], "y": [0, -40]}, "sfx": "boom"},
    {"text": "There is no internet, no cell phone, and nobody who would ever believe you.", "bg": "street55",
     "chars": [{"id": "hero", "pose": "shrug", "x": 960, "color": "#5c6b73", "mood": "awkward", "hair": "gray"}],
     "cam": {"z": [1.15, 1.05], "x": [0, 0], "y": [0, 0]},
     "overlay": {"type": "tag", "text": "NO INTERNET", "color": "#e63946", "at": 0.15}, "sfx": "pop"},
    {"text": "The first time you warn your neighbor about the future, he looks at you like you have lost your mind.", "bg": "street55",
     "chars": [{"id": "hero", "pose": "point", "x": 640, "color": "#5c6b73", "hair": "gray"},
               {"id": "nb", "pose": "idle", "pose2": "skeptical", "x": 1260, "color": "#a8dadc", "facing": -1, "hat": "flat", "mood": "narrow"}],
     "cam": {"z": [1.0, 1.15], "x": [0, -120], "y": [0, 0]}, "sfx": "pop"},
    {"text": "So what would you do first? Tell me in the comments.", "bg": "bedroom55",
     "chars": [{"id": "hero", "pose": "think", "x": 960, "color": "#5c6b73", "hair": "gray"}],
     "cam": {"z": [1.0, 1.25], "x": [0, 0], "y": [0, -30]},
     "overlay": {"type": "endcard", "text": "WHAT WOULD YOU DO FIRST?", "at": 0.4}, "sfx": "shimmer"}
  ]
}
